{
  "expo": {
    "name": "ChildWay",
    "slug": "childway",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ChildWay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/logo/ChildWayLogo2.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ravilez.ChildWay",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow app to use your location.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/ChildWayLogo2.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#12151D"
        }
      ],
      "expo-router",
      "@rnmapbox/maps",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c607237-567c-4424-9677-67509bdfa8be"
      }
    },
    "owner": "ravilez"
  }
}
